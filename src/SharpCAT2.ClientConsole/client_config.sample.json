{
    // SharpCAT2 Client Configuration
    // Only the following options are supported by the client application:
    
    "serverHost": "localhost",          // Server hostname or IP address (default: localhost)
    "serverPort": 8080                  // Server TCP port (default: 8080)
    
    /* UNSUPPORTED OPTIONS (these will be ignored if present):
     * - autoReconnect: Not implemented in client
     * - reconnectIntervalSeconds: Not implemented in client
