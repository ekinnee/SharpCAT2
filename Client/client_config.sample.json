{
    // Client connection settings
    "serverHost": "127.0.0.1",          // Server address (localhost)
    "serverPort": 8080,                 // Default SharpCAT2 server port
    "autoReconnect": true,              // Automatically reconnect on disconnect
    "reconnectIntervalSeconds": 10,     // Wait time between reconnection attempts
    "logging": {
        "level": "Information",         // Log level: Debug, Information, Warning, Error
        "file": "client.log"            // Log file location
    },
    "user": {
        "username": "your-username-here",
        "password": "your-password-here"
    },
    "features": {
        "enableExperimentalUi": false,  // Enable experimental features
        "commandHistoryLimit": 100      // Number of commands to remember
    }
}