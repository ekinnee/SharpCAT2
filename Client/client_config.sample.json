{
    // SharpCAT2 Client Configuration
    // This file configures the client connection to the SharpCAT2 server
    
    /* Server Connection Settings */
    "serverHost": "127.0.0.1",          // Server hostname or IP address
                                        // Use "localhost" or "127.0.0.1" for local server
                                        // Use actual IP address for remote server
    
    "serverPort": 8080                  // TCP port number for server connection
                                        // Default SharpCAT2 server port is 8080
                                        // Must match the tcpPort setting in server configuration
}